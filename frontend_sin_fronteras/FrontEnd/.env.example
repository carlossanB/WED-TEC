# 1. URL base del Backend (Fastify API)
VITE_API_BASE_URL=http://localhost:3001

# 2. Portal de Noticias (APIs públicas JSON con imágenes originales de cada medio)
VITE_LA_OPINION_API_URL=https://laopinion.com/wp-json/wp/v2/posts
VITE_EL_DIARIO_NY_API_URL=https://eldiariony.com/wp-json/wp/v2/posts
VITE_CONEXION_MIGRANTE_API_URL=https://conexionmigrante.com/wp-json/wp/v2/posts
