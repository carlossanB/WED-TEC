{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend_sin_fronteras/FrontEnd && pnpm install && pnpm run build",
  "outputDirectory": "frontend_sin_fronteras/FrontEnd/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
