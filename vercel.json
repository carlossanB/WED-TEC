{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backendsinfronteras": {
      "root": "BackendSinFronteras",
      "framework": "fastify"
    },
    "frontend": {
      "root": "frontend_sin_fronteras/FrontEnd",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backendsinfronteras"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
